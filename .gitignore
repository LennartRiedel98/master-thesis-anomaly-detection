# Python
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# Eingabedaten. Grundregel: kein Datensatz im Repo - der Demo-Datensatz ist
# mit ~140 MB zu gross und in 15 Sekunden reproduzierbar
# (python src/tools/make_synthetic_data.py); im Repo steht der Generator,
# nicht sein Ergebnis.
data/*/
# Ausnahme: die anonymisierte Fassung der Originaldaten. Sie ist die einzige
# Eingabe, aus der die Zahlen der Arbeit entstehen, und laesst sich - anders
# als der Demo-Datensatz - nicht nachbauen. Erzeugt aus dem Originaldatensatz
# mit src/tools/anonymize_dataset.py.
!data/gebaeude_a/

# Pipeline-Outputs (werden aus data/ neu erzeugt; was dort liegt und in
# welchem Format, steht in README.md, Abschnitt "Was im outputs/-Ordner liegt")
outputs/

# Erzeugte Abbildungen. pipeline_diagram.py, plot_ki_schachtelung.py und
# plot_injektionskarte.py --docs-copy schreiben hierher; die Bilder stehen
# in der Arbeit und sind jederzeit reproduzierbar. Im Repo steht der Code,
# nicht sein Ergebnis.
docs/*.png

# Betriebssystem-Artefakte
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
